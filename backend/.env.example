# ============================================================
# CollabSphere Backend — Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# --- Database ---
# Get this from MongoDB Atlas → Connect → Drivers
MONGODB_URL=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
DATABASE_NAME=collabsphere

# --- Auth ---
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-super-secret-key-minimum-32-characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- File Uploads ---
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE=10485760

# --- CORS ---
# Local: http://localhost:5173
# Production: https://your-app.vercel.app  (no trailing slash)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Email (Gmail SMTP) ---
# Google Account → Security → 2-Step Verification → App Passwords
# Select app: Mail, device: Other, name it CollabSphere
GMAIL_USER=yourname@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# --- Frontend URL (used in email invite links) ---
# Local: http://localhost:5173
# Production: https://your-app.vercel.app  (no trailing slash)
FRONTEND_URL=http://localhost:5173