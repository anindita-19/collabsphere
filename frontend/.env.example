# ============================================================
# CollabSphere Frontend — Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# --- Backend API URL ---
# Local:      http://localhost:8000/api/v1
# Production: https://collabsphere-api.onrender.com/api/v1
VITE_API_BASE_URL=http://localhost:8000/api/v1

# --- WebSocket URL ---
# Local:      ws://localhost:8000
# Production: wss://collabsphere-api.onrender.com
# IMPORTANT:  use wss:// (not ws://) in production — Render uses HTTPS
# No trailing slash
VITE_WS_URL=ws://localhost:8000